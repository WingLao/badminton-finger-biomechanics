{"text": "第二步，正手發力。擊球一瞬間，中指、無名指和小指一起握緊，手肘微微打直，前臂向內轉，像甩鞭子一樣把球拍揮出去。研究量到，手指最用力的地方在中指指尖，而且出現在觸球前大約二十到三十毫秒。看右邊，藍色球拍有用手指，灰色沒有，藍色打出的球更快更遠。", "words": [{"t": 0.1, "d": 0.279, "w": "第二"}, {"t": 0.379, "d": 0.446416, "w": "步"}, {"t": 0.91475, "d": 0.323625, "w": "正手"}, {"t": 1.238375, "d": 0.569208, "w": "發力"}, {"t": 2.561166, "d": 0.200875, "w": "擊"}, {"t": 2.762041, "d": 0.133916, "w": "球"}, {"t": 2.896, "d": 0.580375, "w": "一瞬間"}, {"t": 3.587958, "d": 0.625, "w": "中指"}, {"t": 4.30225, "d": 0.111583, "w": "無"}, {"t": 4.413833, "d": 0.290166, "w": "名指"}, {"t": 4.704, "d": 0.111625, "w": "和"}, {"t": 4.815625, "d": 0.15625, "w": "小"}, {"t": 4.971875, "d": 0.100458, "w": "指"}, {"t": 5.072333, "d": 0.212041, "w": "一起"}, {"t": 5.284375, "d": 0.15625, "w": "握"}, {"t": 5.440625, "d": 0.412958, "w": "緊"}, {"t": 5.954, "d": 0.368291, "w": "手肘"}, {"t": 6.322333, "d": 0.212041, "w": "微微"}, {"t": 6.534375, "d": 0.145083, "w": "打"}, {"t": 6.679458, "d": 0.379458, "w": "直"}, {"t": 7.148208, "d": 0.18975, "w": "前"}, {"t": 7.337958, "d": 0.100416, "w": "臂"}, {"t": 7.438375, "d": 0.267875, "w": "向內"}, {"t": 7.70625, "d": 0.43525, "w": "轉"}, {"t": 8.253125, "d": 0.212041, "w": "像"}, {"t": 8.465166, "d": 0.15625, "w": "甩"}, {"t": 8.621416, "d": 0.245541, "w": "鞭子"}, {"t": 8.866958, "d": 0.223208, "w": "一樣"}, {"t": 9.090166, "d": 0.111625, "w": "把"}, {"t": 9.201791, "d": 0.223208, "w": "球拍"}, {"t": 9.425, "d": 0.100458, "w": "揮"}, {"t": 9.525458, "d": 0.580375, "w": "出去"}, {"t": 10.853583, "d": 0.457583, "w": "研究量"}, {"t": 11.311166, "d": 0.346, "w": "到"}, {"t": 11.757583, "d": 0.346, "w": "手指"}, {"t": 12.103583, "d": 0.12275, "w": "最"}, {"t": 12.226333, "d": 0.267875, "w": "用力的"}, {"t": 12.494208, "d": 0.357125, "w": "地方"}, {"t": 12.851333, "d": 0.111625, "w": "在"}, {"t": 12.962958, "d": 0.245541, "w": "中指"}, {"t": 13.2085, "d": 0.46875, "w": "指尖"}, {"t": 13.788833, "d": 0.279, "w": "而且"}, {"t": 14.067875, "d": 0.323625, "w": "出現"}, {"t": 14.3915, "d": 0.100458, "w": "在"}, {"t": 14.491958, "d"